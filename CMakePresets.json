{
  "version": 3,
  "cmakeMinimumRequired": {"major": 3, "minor": 21, "patch": 0},
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release (the build directory the validators expect)",
      "binaryDir": "${sourceDir}/work/ss6/build-native",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "binaryDir": "${sourceDir}/work/ss6/build-debug",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}
    },
    {
      "name": "asan",
      "displayName": "Debug with AddressSanitizer and UBSan",
      "binaryDir": "${sourceDir}/work/ss6/build-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "ci",
      "displayName": "Headless: runtime, tools and tests, no SDL3",
      "binaryDir": "${sourceDir}/work/ss6/build-ci",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SS6_BUILD_GAME": "OFF",
        "SS6_WARNINGS_AS_ERRORS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {"name": "release", "configurePreset": "release"},
    {"name": "debug", "configurePreset": "debug"},
    {"name": "asan", "configurePreset": "asan"},
    {"name": "ci", "configurePreset": "ci"}
  ],
  "testPresets": [
    {"name": "release", "configurePreset": "release", "output": {"outputOnFailure": true}},
    {"name": "debug", "configurePreset": "debug", "output": {"outputOnFailure": true}},
    {"name": "asan", "configurePreset": "asan", "output": {"outputOnFailure": true}},
    {"name": "ci", "configurePreset": "ci", "output": {"outputOnFailure": true}}
  ]
}
